rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;
    }

    match /likes/{likeId} {
      allow read, write: if true;
    }

    match /passes/{passId} {
      allow read, write: if true;
    }

    match /matches/{matchId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /blocks/{blockId} {
      allow read, write: if true;
    }

    match /reports/{reportId} {
      allow read, write: if true;
    }
  }
}


